<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android 12+. Le prenotazioni di sala (STEP 7.7) contengono nomi di clienti e sono
         dichiarate "solo su questo dispositivo": escluse dal backup cloud. Il trasferimento
         diretto su un nuovo telefono dello stesso utente resta consentito. -->
    <cloud-backup>
        <exclude domain="file" path="reservations" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
